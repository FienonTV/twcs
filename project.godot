; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="TwoWorlds CSharp"
run/main_scene="res://World/World.tscn"
config/features=PackedStringArray("4.3", "C#", "Forward Plus")

[autoload]

InputHandler="*res://Characters/Player/PlayerOnlyComponents/InputHandlerComponent/InputHandler.cs"
InventoryMenu="*res://UI/Inventory/Inventory.tscn"
GameManager="*res://GameManager.cs"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/initial_position_type=2
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/aspect="keep_height"
window/stretch/scale_mode="integer"

[dotnet]

project/assembly_name="TwoWorlds CSharp"

[file_customization]

folder_colors={
"res://World/": "green"
}

[global_group]

Player=""
navigation_polygon_source_geometry_group=""

[input]

